@model ECommerce.Models.products

<h1>Product Details</h1>

<p>productID: @Model.productID</p>
<p>productName: @Model.productName</p>
<p>Description: @Model.productDescription</p>
<p>price: @Model.price</p>
<p>stockQuantity: @Model.stockQuantity</p>
<p>category: @Model.category</p>
<p>imageURL: @Model.imageURL</p>
<p>IsActive: @Model.IsActive</p>
