@model ECommerce.Models.Admins

@{
    ViewData["Title"] = "Admin Details";
}

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Admin Details</h3>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    User ID
                </div>
                <div class="col-md-8">
                    @Model.userID
                </div>
            </div>

            <hr />

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Name
                </div>
                <div class="col-md-8">
                    @Model.name
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Phone
                </div>
                <div class="col-md-8">
                    @(string.IsNullOrEmpty(Model.phone) ? "N/A" : Model.phone)
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Role
                </div>
                <div class="col-md-8">
                    @Model.Role
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Hire Date
                </div>
                <div class="col-md-8">
                    @Model.HireDate.ToString("dd MMM yyyy")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Department
                </div>
                <div class="col-md-8">
                    @Model.department
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Access Level
                </div>
                <div class="col-md-8">
                    <span class="badge bg-info">
                        @Model.AccessLevel
                    </span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Can Manage Users
                </div>
                <div class="col-md-8">
                    @if (Model.CanManageUsers)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4 fw-bold">
                    Can Manage Products
                </div>
                <div class="col-md-8">
                    @if (Model.CanManageProducts)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4 fw-bold">
                    Account Status
                </div>
                <div class="col-md-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
            </div>

        </div>

        <div class="card-footer text-end">

            <a asp-action="Edit"
               asp-route-id="@Model.userID"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>