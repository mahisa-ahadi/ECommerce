@model IEnumerable<ECommerce.Models.cart>
<table>
	<tr>
		<th style="padding:10px;"> cartID</th>
		<th style="padding:10px;"> createdAt</th>
		<th style="padding:10px;">customerID</th>
		<th style="padding:10px;">guestID</th>
	</tr>
	@foreach(var c in Model)
	{
		<tr><td style="padding:10px;">@c.cartID</td>
			<td style="padding:10px;">@c.createdAt</td>
			<td style="padding:10px;">@c.customerID</td>
			<td style="padding:10px;">@c.guestID</td>
		</tr>


	}
</table>