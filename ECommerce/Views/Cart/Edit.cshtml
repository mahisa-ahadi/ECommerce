
@model ECommerce.Models.cart

@{
    ViewData["Title"] = "Edit Cart";
}

<h2>Edit Cart</h2>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="cartID" />

    <div class="mb-3">
        <label class="form-label">Created At</label>
        <input asp-for="createdAt" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Cart Owner Type</label>
        <select id="ownerType" class="form-control">
            <option value="">-- Select Owner Type --</option>
            <option value="customer">Customer</option>
            <option value="guest">Guest</option>
        </select>
    </div>

    <div class="mb-3" id="customerDiv">
        <label asp-for="customerID" class="form-label"></label>
        <input asp-for="customerID" class="form-control" />
        <span asp-validation-for="customerID" class="text-danger"></span>
    </div>

    <div class="mb-3" id="guestDiv">
        <label asp-for="guestID" class="form-label"></label>
        <input asp-for="guestID" class="form-control" />
        <span asp-validation-for="guestID" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back to List
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const ownerType = document.getElementById("ownerType");
        const customerDiv = document.getElementById("customerDiv");
        const guestDiv = document.getElementById("guestDiv");

        function updateFields() {

            if (ownerType.value === "customer") {
                customerDiv.style.display = "block";
                guestDiv.style.display = "none";
            }
            else if (ownerType.value === "guest") {
                customerDiv.style.display = "none";
                guestDiv.style.display = "block";
            }
            else {
                customerDiv.style.display = "block";
                guestDiv.style.display = "block";
            }
        }

        if (document.getElementById("customerID").value) {
            ownerType.value = "customer";
        }
        else if (document.getElementById("guestID").value) {
            ownerType.value = "guest";
        }

        updateFields();

        ownerType.addEventListener("change", updateFields);
    </script>
}

