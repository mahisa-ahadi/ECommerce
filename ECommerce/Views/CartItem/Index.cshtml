@using ECommerce.Models.ViewModels
@model IEnumerable<CartItemViewModel>
<h2>Cart Item list</h2>
<table class="table">
	<thead>
		<tr>
			<th>cartItemID</th>
			<th>productID</th>
			<th>productName</th>
			<th>quantity</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var cartitem in Model)
		{
			<tr>
				<td>@cartitem.cartItemID</td>
				<td>@cartitem.productId</td>
				<td>@cartitem.productName</td>
				<td>@cartitem.Quantity</td>
				<td>
					<a asp-action="Details"
					   asp-route-id="@cartitem.cartItemID">
					Details
				</a>
				|
				<a asp-action="Edit"
				asp-route-id="@cartitem.cartItemID">
			Edit
			</a>
			|
			<a asp-action="Delete"
			asp-route-id="@cartitem.cartItemID">
		    Delete
		</a>
				</td>
			</tr>
		}
	</tbody>
</table>