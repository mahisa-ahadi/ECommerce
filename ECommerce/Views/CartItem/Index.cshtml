@model IEnumerable<ECommerce.Models.CartItem>
<h2>Cart Item list</h2>
<table class="table">
	<thead>
		<tr>
			<th>cartItemID</th>
			<th>productID</th>
			<th>cartID</th>
			<th>quantity</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var cartitem in Model)
		{
			<tr>
				<td>@cartitem.cartItemID</td>
				<td>@cartitem.ProductID</td>
				<td>@cartitem.CartID</td>
				<td>@cartitem.Quantity</td>
			</tr>
		}
	</tbody>
</table>