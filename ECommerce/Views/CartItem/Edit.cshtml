@model CartItem
<form method="post">
	@Html.HiddenFor(m => m.cartItemID)


<div>
	<strong>cartItemID:</strong>
	@Html.DisplayFor(m=>m.cartItemID)
</div>
<div>
	<strong>ProductID:</strong>
	<input type="text" name="ProductID" value="@Model.ProductID" />	
</div>
<div>
	<strong>CartID:</strong>
	<input type="text" name="CartID" value="@Model.CartID"/>
</div>
<div>
	<strong>Quantity:</strong>
	<input type="number" name="Quantity" value="@Model.Quantity"/>
</div>
<div>
	<button type="submit">save</button>
</div>

</form>
