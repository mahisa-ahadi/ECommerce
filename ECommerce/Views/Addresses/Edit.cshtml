@model ECommerce.Models.Addresses

@{
    ViewData["Title"] = "Edit Address";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3>Edit Address</h3>
        </div>


        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="AddressID" />


                <div class="mb-3">

                    <label asp-for="exactAddress"
                           class="form-label">
                        Exact Address
                    </label>

                    <textarea asp-for="exactAddress"
                              class="form-control">
                    </textarea>

                </div>


                <div class="mb-3">

                    <label asp-for="userID"
                           class="form-label">
                        User ID
                    </label>

                    <input asp-for="userID"
                           class="form-control" />

                </div>


                <div class="form-check mb-3">

                    <input asp-for="isDefault"
                           class="form-check-input" />

                    <label asp-for="isDefault"
                           class="form-check-label">
                        Default Address
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-success">
                    Save
                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>