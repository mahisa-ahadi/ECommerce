@model ECommerce.Models.users
@if (Model == null)
{
    <h1>Model is NULL</h1>
    return;
}
@{
    ViewBag.Title = "Delete User";
}

<h2>Delete User</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this user?
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.name</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.phone</dd>

    <dt class="col-sm-3">Role</dt>
    <dd class="col-sm-9">@Model.Role</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Yes" : "No")
    </dd>
</dl>

@using (Html.BeginForm("Delete", "Users", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.userID)
    @Html.HiddenFor(m => m.passwordHash)

    <input type="submit" value="Delete" class="btn btn-danger" />
    <a href="@Url.Action("Index", "Users")" class="btn btn-secondary">
        Cancel
    </a>
}
