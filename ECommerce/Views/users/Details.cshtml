@model ECommerce.Models.users

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">User Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    User ID
                </dt>
                <dd class="col-sm-9">
                    @Model.userID
                </dd>

                <dt class="col-sm-3">
                    Name
                </dt>
                <dd class="col-sm-9">
                    @Model.name
                </dd>

                <dt class="col-sm-3">
                    Phone
                </dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.phone) ? "Not Provided" : Model.phone)
                </dd>

                <dt class="col-sm-3">
                    Role
                </dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Model.Role
                    </span>
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.userID"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>

        </div>
    </div>

</div>
