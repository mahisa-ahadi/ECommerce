@model IEnumerable<ECommerce.Models.Customer>

<h2>Customer list</h2>
<table>
    <thead>
        <tr>
            <th>CustomerID</th>
            <th>Name</th>
            <th>WishlistVisibility</th>
            <th>LoyaltyPoints</th>
            <th>DateOfBirth</th>
            <th>PreferredPaymentMethodID</th>
            <th>Actions</th>
		</tr>
   </thead>
   <tbody>
       @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.userID</td>
                <td>@customer.name</td>
                <td>@customer.WishlistVisibility</td>
                <td>@customer.LoyaltyPoints</td>
                <td>@customer.DateOfBirth.ToShortDateString()</td>
				<td>@customer.PreferredPaymentMethodID</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@customer.userID">
						Details</a>
                                            |
                    <a asp-action="Edit"
					   asp-route-id="@customer.userID">Edit
                       </a>
                       |
                       <a asp-action="Delete" asp-rout-id="@customer.userID">
                           Delete
                       </a>
                </td>
                    </tr>

        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-primary">Create New Customer</a>
